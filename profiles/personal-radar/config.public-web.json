{
  "ai": {
    "provider": "openai-chatgpt",
    "model": "PENDING_AUTH",
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 2,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "work-ai",
    "profile_settings": {
      "work-frontend": {
        "threshold": 7,
        "topic_dedup": true
      },
      "work-product": {
        "threshold": 7,
        "topic_dedup": true
      },
      "work-operations": {
        "threshold": 7,
        "topic_dedup": true
      },
      "work-ai": {
        "threshold": 7,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "category": "ai-tools",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ]
      },
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "category": "ai-tools",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ]
      },
      {
        "name": "GitHub Blog",
        "url": "https://github.blog/feed/",
        "category": "open-source",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ]
      },
      {
        "name": "Hugging Face",
        "url": "https://huggingface.co/blog/feed.xml",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ],
        "content_extractor": "trafilatura"
      },
      {
        "name": "少数派",
        "url": "https://sspai.com/feed",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ],
        "content_extractor": "trafilatura"
      },
      {
        "name": "阮一峰",
        "url": "https://www.ruanyifeng.com/blog/atom.xml",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ],
        "content_extractor": "trafilatura"
      },
      {
        "name": "V2EX技术",
        "url": "https://www.v2ex.com/feed/tab/tech.xml",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ],
        "content_extractor": "trafilatura"
      },
      {
        "name": "掘金",
        "url": "https://juejin.cn/rss",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ],
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Changelog",
        "url": "https://github.blog/changelog/feed/",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ],
        "content_extractor": "trafilatura"
      },
      {
        "name": "anthropics/claude-code releases",
        "url": "https://github.com/anthropics/claude-code/releases.atom",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ]
      },
      {
        "name": "openai/codex releases",
        "url": "https://github.com/openai/codex/releases.atom",
        "category": "practice",
        "profile": [
          "work-frontend",
          "work-product",
          "work-operations",
          "work-ai"
        ]
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "category": "discovery",
      "profile": [
        "work-frontend",
        "work-product",
        "work-operations",
        "work-ai"
      ]
    },
    "web_search": {
      "enabled": true,
      "queries": [
        "AI 前端 页面 组件 测试 调试 实战 工作流",
        "AI 产品经理 需求访谈 PRD 原型 验收 实践",
        "AI 运营 内容 活动 用户反馈 数据分析 实操",
        "AI 知识库 自动化 工作流 评测 实践 教程",
        "AI frontend component browser debugging testing workflow tutorial",
        "AI product manager user interviews PRD prototype acceptance criteria workflow",
        "AI marketing operations content campaign customer feedback analysis workflow",
        "AI knowledge base workflow automation evaluation practical tutorial",
        "site:github.com AI workflow tutorial examples",
        "site:reddit.com AI product operations workflow experience",
        "site:mp.weixin.qq.com AI 产品 运营 实践",
        "site:youtube.com AI frontend product workflow tutorial",
        "site:zhihu.com AI 工作流 实践",
        "site:x.com AI workflow practical example"
      ],
      "max_results_per_query": 4,
      "max_total_results": 60,
      "region": "wt-wt",
      "backend": "bing",
      "fetch_body": true,
      "max_body_chars": 18000,
      "category": "practice",
      "profile": [
        "work-frontend",
        "work-product",
        "work-operations",
        "work-ai"
      ]
    },
    "google_news": {
      "enabled": true,
      "query": "\"AI 工作流\" OR \"AI 产品经理\" OR \"AI 运营\" OR \"AI 前端\" OR \"AI knowledge base\"",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 20,
      "category": "discovery",
      "profile": [
        "work-frontend",
        "work-product",
        "work-operations",
        "work-ai"
      ]
    },
    "github": [],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "profile": [
        "work-frontend",
        "work-product",
        "work-operations",
        "work-ai"
      ]
    },
    "telegram": {
      "enabled": false,
      "channels": [],
      "profile": [
        "work-frontend",
        "work-product",
        "work-operations",
        "work-ai"
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 4,
    "group_by": "profile",
    "profile_order": [
      "work-frontend",
      "work-product",
      "work-operations",
      "work-ai"
    ],
    "category_groups": {
      "work-frontend": {
        "name": "前端",
        "limit": 1,
        "categories": [
          "work-frontend"
        ]
      },
      "work-product": {
        "name": "产品",
        "limit": 1,
        "categories": [
          "work-product"
        ]
      },
      "work-operations": {
        "name": "运营",
        "limit": 1,
        "categories": [
          "work-operations"
        ]
      },
      "work-ai": {
        "name": "AI",
        "limit": 1,
        "categories": [
          "work-ai"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": true
  }
}
